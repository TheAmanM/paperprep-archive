rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  match /emails/{document} {
  	allow create: if true;
    allow update: if false;
    allow delete: if false;
    
    allow read: if false;
  }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}